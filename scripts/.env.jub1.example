# انسخ هذا الملف إلى scripts/.env.jub1 وعبّي القيم — لا يُرفع للمستودع
# مفتاح service_role من: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# مفتاح Anthropic (نفس المستخدم في أسرار edge functions)
ANTHROPIC_API_KEY=
# مسار مجلد صور السندات (أو مرّره بـ --dir عند التشغيل)
IMAGES_DIR=
# اختياري — الافتراضي مشروع الإنتاج
# SUPABASE_URL=https://gcvshzutdslmdkwqwteh.supabase.co
